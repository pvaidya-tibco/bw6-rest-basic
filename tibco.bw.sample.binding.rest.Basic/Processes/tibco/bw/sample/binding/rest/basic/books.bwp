    xmlns:tibprop="http://ns.tibco.com/bw/property" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <tibex:VariableDescriptor type="MemorySaving">
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
                <variable>PostBooksToFile</variable>
            </endingVariables>
        </task>
        <task name="PostBooksToFile">
            <endingVariables>
                <variable>PostBooksToFile-input</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="getOut">
            <endingVariables>
                <variable>getOut-input</variable>
                <variable>GetBooksFromFile</variable>
            </endingVariables>
        </task>
        <task name="GetBooksFromFile">
            <endingVariables>
                <variable>GetBooksFromFile-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
    <tibex:Types>
        <xs:schema attributeFormDefault="unqualified"
