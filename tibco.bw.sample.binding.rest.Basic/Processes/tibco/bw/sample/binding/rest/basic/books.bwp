<bpws:process exitOnStandardFault="no"
    name="tibco.bw.sample.binding.rest.basic.books"
    suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20241009152619"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://xmlns.example.com/20241009152619PLT"
    xmlns:ns0="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns1="http://xmlns.example.com/20140930153240"
    xmlns:ns2="http://tns.tibco.com/bw/palette/internal/activityerror+f4abaaf5-ee95-4f84-b005-79a4d5004bf9"
    xmlns:ns3="http://tns.tibco.com/bw/palette/internal/activityerror+210fdeed-a2f1-4c3b-9f29-2db51c823e95"
    xmlns:sca="http://docs.oasis-open.org/ns/opencsa/sca/200912"
    xmlns:sca-bpel="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"
