    <tibex:VariableDescriptor type="MemorySaving">
        <task name="Timer">
            <endingVariables>
                <variable>Timer</variable>
            </endingVariables>
        </task>
        <task name="Sleep">
            <endingVariables>
                <variable>Sleep-input</variable>
            </endingVariables>
        </task>
        <task name="ReadFile">
            <endingVariables>
                <variable>ReadFile-input</variable>
            </endingVariables>
        </task>
        <task name="ParseJSON">
            <endingVariables>
                <variable>ParseJSON-input</variable>
                <variable>ReadFile</variable>
            </endingVariables>
        </task>
        <task name="post">
            <endingVariables>
                <variable>post-input</variable>
                <variable>ParseJSON</variable>
            </endingVariables>
        </task>
        <task name="RenderJSON">
            <endingVariables>
                <variable>RenderJSON-input</variable>
                <variable>post</variable>
            </endingVariables>
        </task>
        <task name="WriteFile">
            <endingVariables>
                <variable>WriteFile-input</variable>
                <variable>WriteFile</variable>
                <variable>RenderJSON</variable>
            </endingVariables>
        </task>
        <task name="get">
            <endingVariables>
                <variable>get-input</variable>
            </endingVariables>
        </task>
        <task name="RenderJSON1">
            <endingVariables>
                <variable>RenderJSON1-input</variable>
                <variable>get</variable>
            </endingVariables>
        </task>
        <task name="WriteFile1">
            <endingVariables>
                <variable>WriteFile1-input</variable>
                <variable>WriteFile1</variable>
                <variable>RenderJSON1</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
