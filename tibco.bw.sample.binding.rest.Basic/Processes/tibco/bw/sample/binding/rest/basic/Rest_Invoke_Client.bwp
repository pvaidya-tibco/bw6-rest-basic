                        <referenceBinding name="books" xsi:type="scact:Reference">
                            <sca:interface.wsdl
                                interface="http://xmlns.example.com/20241009171929PLT#wsdl.interface(books)" scaext:wsdlLocation=""/>
                            <scaext:binding basePath="/"
                                connector="tibco.bw.sample.binding.rest.basic.HttpClientResource"
                                docBasePath="http://localhost:7777/"
                                docResourcePath="Books"
                                host="localhost:8080"
                                implementation="Service Descriptors/tibco.bw.sample.binding.rest.basic.books-Resource.json"
                                name="RestReference" path="/books"
                                structuredData="true"
                                technologyVersion="2.0" xsi:type="rest:RestReferenceBinding">
                                <operation httpMethod="POST"
                                    nickname="post-books"
                                    notes="postResource"
                                    operationName="post"
                                    requestEntityProcessing="chunked"
                                    requestStyle="element" responseStyle="element">
                                    <clientFormat>json</clientFormat>
                                    <clientRequestFormat>json</clientRequestFormat>
                                </operation>
                                <operation httpMethod="GET"
                                    nickname="get-books"
                                    notes="getResource"
                                    operationName="get"
                                    requestEntityProcessing="chunked" responseStyle="element">
                                    <clientFormat>json</clientFormat>
                                    <clientRequestFormat>json</clientRequestFormat>
                                </operation>
                                <parameters/>
                                <advancedConfig blockingQueueSize="8192"/>
                            </scaext:binding>
                        </referenceBinding>
